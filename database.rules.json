{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'videocinema80@gmail.com' || auth.token.email === 'ranveerkrsingh165@gmail.com' || ($uid === auth.uid && (!data.exists() || (data.child('role').val() !== 'admin' && (!newData.hasChild('plan') || newData.child('plan').val() === data.child('plan').val()) && (!newData.hasChild('role') || newData.child('role').val() === data.child('role').val())))))",
        "username": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "profileImage": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "lastLogin": {
          ".validate": "newData.isString() || newData.isNumber()"
        }
      }
    },
    "videos": {
      ".read": true,
      ".indexOn": ["seriesId", "seriesName", "published", "episodeNumber", "createdAt", "accessType", "requiredPlan"],
      "$videoId": {
        ".read": true,
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'videocinema80@gmail.com' || auth.token.email === 'ranveerkrsingh165@gmail.com')",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
        },
        "embedUrl": {
          ".validate": "newData.isString() && newData.val().length > 0"
        }
      }
    }
  }
}
