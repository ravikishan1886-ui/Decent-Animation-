rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDesignatedAdminEmail(email) {
      return email == 'videocinema80@gmail.com' ||
             email == 'ranveerkrsingh165@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isDesignatedAdminEmail(request.auth.token.email) ||
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Test connection probe
    match /test/{testId} {
      allow read, write: if true;
    }

    // Videos - Public video catalog with admin management
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || true;
      allow list: if true;

      allow create: if isOwner(userId) || isAdmin();
      allow update: if (
        isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          isDesignatedAdminEmail(request.auth.token.email) ||
          isAdmin()
        )
      ) || isAdmin();

      allow delete: if isOwner(userId) || isAdmin();

      match /watchHistory/{videoId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /watchlist/{videoId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Comments & Moderation
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() || true;
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // Comment Reports
    match /commentReports/{reportId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Polls & Voting
    match /polls/{pollId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pollVotes/{voteId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    // Live Streams & Live Chat
    match /liveStreams/{liveId} {
      allow read: if true;
      allow write: if isAdmin();

      match /chat/{messageId} {
        allow read: if true;
        allow create: if isSignedIn() || true;
        allow update, delete: if isAdmin();
      }
    }

    // Super Chats
    match /superChats/{chatId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // In-App Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) || true;
      allow create, update: if true;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) || isAdmin();
    }

    // Subscriptions
    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) || isAdmin();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin()) || isAdmin();
      allow update: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin()) || isAdmin();
      allow delete: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) || isAdmin();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin()) || isAdmin();
      allow update: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin()) || isAdmin();
      allow delete: if isAdmin();
    }

    // Watch history root collection
    match /watchHistory/{historyId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) || isAdmin();
    }

    // Notification delivery logs
    match /notificationLogs/{logId} {
      allow read, write: if true;
    }

    // Fallback default deny
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
