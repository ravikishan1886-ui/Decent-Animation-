rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDesignatedAdminEmail(email) {
      return email == 'videocinema80@gmail.com' ||
             email == 'ranveerkrsingh165@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isDesignatedAdminEmail(request.auth.token.email) ||
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Test connection probe
    match /test/{testId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      // Owners and Admins can read the user document. Any signed-in user can read their own profile.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Allow creating own profile on first login/signup
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'user' ||
        isDesignatedAdminEmail(request.auth.token.email) ||
        isAdmin()
      );

      // Allow user to update their own profile fields, preventing self-assigned role changes unless designated admin
      allow update: if (
        isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          isDesignatedAdminEmail(request.auth.token.email) ||
          isAdmin()
        )
      ) || isAdmin();

      allow delete: if isAdmin();

      // User watch history & watchlist subcollections
      match /watchHistory/{videoId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /watchlist/{videoId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Videos
    match /videos/{videoId} {
      // Anyone can read published videos catalog; private video playback is verified server-side
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Subscriptions
    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // User watch history (userId_videoId format)
    match /watchHistory/{historyId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Notification delivery logs
    match /notificationLogs/{logId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Fallback default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
